#, fuzzy
msgid "plugins.generic.customMetadata.displayName"
msgstr "Tilpassede metadata"

#, fuzzy
msgid "plugins.generic.customMetadata.description"
msgstr "Legger til konfigurerbare ekstra metadatafelt i publikasjonens fane Metadata, til bruk i temaet. Hvert felt kan redigeres også av forfatterne eller bare av redaktørene."

#, fuzzy
msgid "plugins.generic.customMetadata.fields.label"
msgstr "Feltdefinisjoner"

#, fuzzy
msgid "plugins.generic.customMetadata.fields.description"
msgstr "Ett felt per linje, i formatet: key | Label | type | multilingual | who edits. Typen kan være text (standard) eller textarea. Bruk 1 eller yes i fjerde kolonne for flerspråklige felt. Skriv editors i femte kolonne for et felt som bare redaktørene kan endre: forfatterne ser det skrivebeskyttet. La den stå tom, så kan også forfatterne redigere det. Nøkkelen godtar bare bokstaver, tall og understrek og er navnet som brukes til å lese verdien i temaet, f.eks. $publication->getData('printIsbn'). Linjer som begynner med # ignoreres."

#, fuzzy
msgid "plugins.generic.customMetadata.fields.ignored"
msgstr "En linje der nøkkelen allerede finnes i publikasjonen (for eksempel title eller abstract) eller gjentar en tidligere nøkkel, ignoreres."

#, fuzzy
msgid "plugins.generic.customMetadata.editorsOnly"
msgstr "Bare redaktørene kan endre dette feltet."
