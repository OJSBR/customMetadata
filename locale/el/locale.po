#, fuzzy
msgid "plugins.generic.customMetadata.displayName"
msgstr "Προσαρμοσμένα μεταδεδομένα"

#, fuzzy
msgid "plugins.generic.customMetadata.description"
msgstr "Προσθέτει διαμορφώσιμα πρόσθετα πεδία μεταδεδομένων στην καρτέλα Μεταδεδομένα της δημοσίευσης, για χρήση στο θέμα. Κάθε πεδίο μπορεί να επεξεργάζεται και από τους συγγραφείς ή μόνο από τους επιμελητές."

#, fuzzy
msgid "plugins.generic.customMetadata.fields.label"
msgstr "Ορισμοί πεδίων"

#, fuzzy
msgid "plugins.generic.customMetadata.fields.description"
msgstr "Ένα πεδίο ανά γραμμή, στη μορφή: key | Label | type | multilingual | who edits. Ο τύπος μπορεί να είναι text (προεπιλογή) ή textarea. Χρησιμοποιήστε 1 ή yes στην τέταρτη στήλη για πολύγλωσσα πεδία. Γράψτε editors στην πέμπτη στήλη για πεδίο που μόνο οι επιμελητές μπορούν να αλλάξουν: οι συγγραφείς το βλέπουν μόνο για ανάγνωση. Αφήστε την κενή ώστε να μπορούν και οι συγγραφείς να το επεξεργαστούν. Το κλειδί δέχεται μόνο γράμματα, αριθμούς και κάτω παύλα και είναι το όνομα με το οποίο διαβάζεται η τιμή στο θέμα, π.χ. $publication->getData('printIsbn'). Οι γραμμές που αρχίζουν με # αγνοούνται."

#, fuzzy
msgid "plugins.generic.customMetadata.fields.ignored"
msgstr "Μια γραμμή της οποίας το κλειδί υπάρχει ήδη στη δημοσίευση (όπως title ή abstract) ή επαναλαμβάνει προηγούμενο κλειδί αγνοείται."

#, fuzzy
msgid "plugins.generic.customMetadata.editorsOnly"
msgstr "Μόνο οι επιμελητές μπορούν να αλλάξουν αυτό το πεδίο."
