msgstr "Հարմարեցված մետատվյալներ"

#, fuzzy
msgid "plugins.generic.customMetadata.description"
msgstr "Ավելացնում է կարգավորելի լրացուցիչ մետատվյալների դաշտեր հրապարակման Մետատվյալներ ներդիրում՝ թեմայում օգտագործելու համար։ Յուրաքանչյուր դաշտ կարող է խմբագրվել նաև հեղինակների կողմից կամ միայն խմբագիրների կողմից։"

#, fuzzy
msgid "plugins.generic.customMetadata.fields.label"
msgstr "Դաշտերի սահմանումներ"

#, fuzzy
msgid "plugins.generic.customMetadata.fields.description"
msgstr "Մեկ դաշտ յուրաքանչյուր տողում, ձևաչափով՝ key | Label | type | multilingual | who edits։ Տեսակը կարող է լինել text (լռելյայն) կամ textarea։ Բազմալեզու դաշտերի համար չորրորդ սյունակում գրեք 1 կամ yes։ Հինգերորդ սյունակում գրեք editors այն դաշտի համար, որը միայն խմբագիրները կարող են փոխել. հեղինակները այն տեսնում են միայն ընթերցման համար։ Թողեք դատարկ, որպեսզի հեղինակները նույնպես կարողանան խմբագրել։ Բանալին ընդունում է միայն տառեր, թվեր և ընդգծման նշան և այն անունն է, որով արժեքը կարդացվում է թեմայում, օրինակ՝ $publication->getData('printIsbn')։ # նշանով սկսվող տողերը անտեսվում են։"

